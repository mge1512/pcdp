# generated from spec: pcd-slice.spec.md sha256:c200af55518fdfe36de34be5a2dfdcc822a16e31410c131bbd8390a6d7897c0f
#
# Translation workflow for pcd-slice: inputs consumed, phases executed,
# artefacts produced. Render with pikchr(1).

scale = 0.9

box "pcd-slice.spec.md" "v0.1.1" fit fill 0xeef7ff
move right 0.35
box "cli-tool.template.md" "v0.4.1" fit fill 0xeef7ff
move right 0.35
box "go hints x2" "ROLE.md" fit fill 0xeef7ff

down
move to 1st box.s
move down 0.45
Inputs: box "merged spec text" "sha256 c200af55…" fit fill 0xfff8e1 with .n at 1st box.s + (1.6,-0.45)

arrow from 1st box.s to Inputs.nw chop
arrow from 2nd box.s to Inputs.n chop
arrow from 3rd box.s to Inputs.ne chop

P1: box "Phase 1 — tests first" "independent_tests/claude-opus-5/" fit \
    fill 0xe8f5e9 with .n at Inputs.s + (0,-0.4)
arrow from Inputs.s to P1.n

P2: box "Phase 2 — implementation" "cmd/pcd-slice + internal/pcdslice" fit \
    fill 0xe8f5e9 with .n at P1.s + (0,-0.35)
arrow from P1.s to P2.n

P3: box "Phase 3 — packaging" "Makefile, pcd-slice.spec, debian/" fit \
    fill 0xe8f5e9 with .n at P2.s + (0,-0.35)
arrow from P2.s to P3.n

P5: box "Phase 5 — docs" "README.md, pcd-slice.1" fit \
    fill 0xe8f5e9 with .n at P3.s + (0,-0.35)
arrow from P3.s to P5.n

P6: box "Phase 6 — compile gate" "go build / go vet / make test" fit \
    fill 0xffe0b2 with .n at P5.s + (0,-0.35)
arrow from P5.s to P6.n

P7: box "Phase 7 — TRANSLATION_REPORT.md" fit \
    fill 0xf3e5f5 with .n at P6.s + (0,-0.35)
arrow from P6.s to P7.n

# the verbs the produced binary offers
right
V: box "pcd-slice" "list | check | slice | version" fit fill 0xe1f5fe \
   with .w at P6.e + (0.8,0)
arrow from P6.e to V.w

box "out/preamble.md" fit fill 0xffffff with .w at V.e + (0.6,0.45)
arrow from V.e to last box.w chop
box "out/<behavior>.md" fit fill 0xffffff with .w at V.e + (0.6,0)
arrow from V.e to last box.w chop
box "out/MANIFEST.tsv" fit fill 0xffffff with .w at V.e + (0.6,-0.45)
arrow from V.e to last box.w chop
