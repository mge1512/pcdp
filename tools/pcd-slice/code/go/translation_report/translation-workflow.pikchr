# translation-workflow.pikchr
# generated from spec: pcd-slice.spec.md sha256:bb31cb27325030a420f0c1ffd8fd2660c9d9ee768f8b50f475360e451b8e6e04
#
# The translation workflow of pcd-slice: from the specification and its
# hints to the verified, packaged binary.

scale = 0.9

Spec:    box "pcd-slice.spec.md" "Spec-SHA256 bb31cb27..." fit fill 0xeef7ff
move right 0.4
Hints:   box "pcd-slice.go.hints.md" "cli-tool.go.milestones.hints.md" fit fill 0xeef7ff
move right 0.4
Tmpl:    box "cli-tool.template.md" "v0.4.1" fit fill 0xeef7ff

down
move to (Hints.x, Hints.y - 0.8)
Tests:   box "Phase 1  Tests First" "independent_tests/claude-opus-5/" "44 black-box tests via exec.Command" fit fill 0xfff7e6

arrow from Spec.s down 0.35 then to Tests.nw ->
arrow from Hints.s to Tests.n ->
arrow from Tmpl.s down 0.35 then to Tests.ne ->

move to (Tests.x, Tests.y - 0.75)
Impl:    box "Phase 2  Implementation" "cmd/pcd-slice/main.go  (CLI dispatch)" \
             "internal/pcd-slice/  (parse, closure, hints," "check, render, verbs, write)" fit fill 0xe9ffe9
arrow from Tests.s to Impl.n -> "guard: tests exist" ljust

move to (Impl.x, Impl.y - 0.75)
Pack:    box "Phase 3  Build and packaging" "Makefile, pcd-slice.spec, debian/, LICENSE" fit fill 0xf3e9ff
arrow from Impl.s to Pack.n ->

move to (Pack.x, Pack.y - 0.6)
Docs:    box "Phase 4-5  Auxiliary and docs" "this diagram, pcd-slice.1(.md), README.md" fit fill 0xf3e9ff
arrow from Pack.s to Docs.n ->

move to (Docs.x, Docs.y - 0.7)
Gate:    box "Phase 6  Compile gate" "go mod tidy / go build ./... / go vet ./..." "make test: 44 passed, 0 failed, 0 skipped" fit fill 0xffe9e9
arrow from Docs.s to Gate.n ->

move to (Gate.x, Gate.y - 0.7)
Report:  box "Phase 7  TRANSLATION_REPORT.md" "written last, after the gate" fit fill 0xffffff
arrow from Gate.s to Report.n ->

# The spec hash travels into every artefact.
arrow from Spec.w left 0.3 then down 4.55 then right 0.3 to Report.w -> \
      "spec hash" "embedded in" "every artefact" ljust
