#!/usr/bin/make -f
# generated from spec: pcd-slice.spec.md sha256:c200af55518fdfe36de34be5a2dfdcc822a16e31410c131bbd8390a6d7897c0f

export DH_VERBOSE = 1
export CGO_ENABLED = 0
export GOCACHE = $(CURDIR)/.gocache
export GOPATH = $(CURDIR)/.gopath
export GOFLAGS = -trimpath

VERSION := $(shell cat VERSION)

%:
	dh $@

override_dh_auto_build:
	go build -ldflags "-s -w -X main.version=$(VERSION)" -o pcd-slice ./cmd/pcd-slice
	pandoc pcd-slice.1.md -s -t man -o pcd-slice.1

override_dh_auto_test:
	go test ./independent_tests/claude-opus-5/...

override_dh_auto_install:
	install -D -m 0755 pcd-slice debian/pcd-slice/usr/bin/pcd-slice
	install -D -m 0644 pcd-slice.1 debian/pcd-slice/usr/share/man/man1/pcd-slice.1

override_dh_auto_clean:
	rm -f pcd-slice pcd-slice.1
	rm -rf .gocache .gopath
