#!/usr/bin/make -f
# generated from spec: pcd-slice.spec.md sha256:bb31cb27325030a420f0c1ffd8fd2660c9d9ee768f8b50f475360e451b8e6e04

export DH_VERBOSE = 1
export CGO_ENABLED = 0
export GOFLAGS = -mod=vendor
export GOCACHE = $(CURDIR)/.gocache

VERSION := $(shell cat VERSION)

%:
	dh $@

override_dh_auto_build:
	go build -ldflags "-X main.version=$(VERSION)" -o pcd-slice ./cmd/pcd-slice
	pandoc pcd-slice.1.md -s -t man -o pcd-slice.1

override_dh_auto_test:
	./pcd-slice version

override_dh_auto_install:
	install -D -m 0755 pcd-slice debian/pcd-slice/usr/bin/pcd-slice
	install -D -m 0644 pcd-slice.1 debian/pcd-slice/usr/share/man/man1/pcd-slice.1

override_dh_auto_clean:
	rm -f pcd-slice pcd-slice.1
	rm -rf $(CURDIR)/.gocache
